[
 {"command":"document.metadata.set","params":{"values":{"part_number":"GRIP-0002","description":"ADAPTER, GRIPPER, DOVETAIL","revision":"X1","project":"gripper_tester"}}},
 {"command":"parameters.add","params":{"name":"dt_len","expression":"40 mm","comment":"slide length, matches baseplate receiver"}},
 {"command":"parameters.add","params":{"name":"dt_bot","expression":"34 mm","comment":"dovetail width at bottom"}},
 {"command":"parameters.add","params":{"name":"dt_top","expression":"28 mm","comment":"dovetail width at top"}},
 {"command":"parameters.add","params":{"name":"dt_h","expression":"6 mm","comment":"dovetail height"}},
 {"command":"parameters.add","params":{"name":"head_h","expression":"4 mm","comment":"block above the rails"}},
 {"command":"parameters.add","params":{"name":"horn_d","expression":"19.6 mm","comment":"locating boss, SO-101 gripper hub has a 20 mm horn recess"}},
 {"command":"parameters.add","params":{"name":"horn_h","expression":"0.9 mm","comment":"recess is 1 mm deep"}},
 {"command":"parameters.add","params":{"name":"bc_half","expression":"4.9497 mm","comment":"STS3215 horn holes: 4x on 14 mm circle at 45 deg"}},
 {"command":"parameters.add","params":{"name":"insert_d","expression":"4 mm","comment":"M3 heat-set insert hole"}},
 {"command":"parameters.add","params":{"name":"insert_depth","expression":"6 mm"}},
 {"command":"sketch.create","params":{"plane":"YZ","offset":"-dt_len/2","name":"ProfileSketch"}},
 {"command":"sketch.line","params":{"points":[["-dt_bot/2",0],["dt_bot/2",0],["dt_top/2","dt_h"],["dt_top/2","dt_h + head_h"],["-dt_top/2","dt_h + head_h"],["-dt_top/2","dt_h"]],"closed":true}},
 {"command":"sketch.finish","params":{}},
 {"command":"solid.extrude","params":{"distance":"dt_len","operation":"new","body_name":"adapter","name":"Slider"}},
 {"command":"solid.cylinder","params":{"diameter":"horn_d","height":"horn_h","base":[0,0,"dt_h + head_h"],"operation":"join","targets":["adapter"],"name":"HornBoss"}},
 {"command":"solid.cylinder","params":{"diameter":"insert_d","height":"insert_depth + 0.01 mm","base":["bc_half","bc_half","dt_h + head_h + horn_h - insert_depth"],"operation":"cut","targets":["adapter"],"name":"InsertHole"}},
 {"command":"solid.pattern.rectangular","params":{"features":["InsertHole"],"dir1":[-1,0,0],"count1":2,"spacing1":"2*bc_half","dir2":[0,-1,0],"count2":2,"spacing2":"2*bc_half","name":"InsertHoles"}},
 {"command":"solid.chamfer","params":{"edges":[[-20,15.5,3],[-20,-15.5,3]],"distance":"0.6 mm","body":"adapter","name":"LeadIn"}},
 {"command":"file.export_step","params":{"path":"gripper_tester/exports/GRIP-0002_gripper-adapter_X1.step","bodies":["adapter"]}},
 {"command":"file.export_stl","params":{"path":"gripper_tester/exports/GRIP-0002_gripper-adapter_X1.stl","bodies":["adapter"],"quality":"fine"}},
 {"command":"file.export_3mf","params":{"path":"gripper_tester/exports/GRIP-0002_gripper-adapter_X1.3mf","bodies":["adapter"],"quality":"fine"}}
]
