[
 {"command":"document.metadata.set","params":{"values":{"part_number":"GRIP-0001","description":"BASEPLATE, GRIPPER TESTER","revision":"X1","project":"gripper_tester"}}},
 {"command":"parameters.add","params":{"name":"L","expression":"150 mm","comment":"plate length (X)"}},
 {"command":"parameters.add","params":{"name":"W","expression":"80 mm","comment":"plate width (Y)"}},
 {"command":"parameters.add","params":{"name":"T","expression":"5 mm","comment":"plate thickness"}},
 {"command":"parameters.add","params":{"name":"corner_r","expression":"6 mm"}},
 {"command":"parameters.add","params":{"name":"mount_d","expression":"4.5 mm","comment":"M4 clearance, table / feet mounting"}},
 {"command":"parameters.add","params":{"name":"mount_inset","expression":"7 mm"}},
 {"command":"parameters.add","params":{"name":"gx","expression":"-40 mm","comment":"gripper station centre (hub axis) X"}},
 {"command":"parameters.add","params":{"name":"dt_len","expression":"40 mm","comment":"dovetail receiver length (slide along X, open towards -X)"}},
 {"command":"parameters.add","params":{"name":"dt_bot","expression":"34 mm","comment":"adapter dovetail width at bottom"}},
 {"command":"parameters.add","params":{"name":"dt_top","expression":"28 mm","comment":"adapter dovetail width at top"}},
 {"command":"parameters.add","params":{"name":"dt_h","expression":"6 mm","comment":"dovetail height = rail height"}},
 {"command":"parameters.add","params":{"name":"clr","expression":"0.2 mm","comment":"per-side sliding clearance"}},
 {"command":"parameters.add","params":{"name":"rail_w","expression":"48 mm","comment":"receiver overall width (Y)"}},
 {"command":"parameters.add","params":{"name":"stop_t","expression":"4 mm","comment":"end stop wall"}},
 {"command":"parameters.add","params":{"name":"lock_d","expression":"4 mm","comment":"M3 heat-set insert hole for the thumb-screw lock"}},
 {"command":"parameters.add","params":{"name":"bx","expression":"40 mm","comment":"control board centre X"}},
 {"command":"parameters.add","params":{"name":"brd_dx","expression":"37 mm","comment":"Waveshare bus servo board hole pitch X"}},
 {"command":"parameters.add","params":{"name":"brd_dy","expression":"28 mm","comment":"Waveshare bus servo board hole pitch Y"}},
 {"command":"parameters.add","params":{"name":"boss_d","expression":"9 mm"}},
 {"command":"parameters.add","params":{"name":"boss_h","expression":"4 mm"}},
 {"command":"parameters.add","params":{"name":"spacer_d","expression":"5 mm","comment":"press fit for M2.5 x 6 HEX5 spacer, as SO-101 WaveShare plate"}},
 {"command":"parameters.add","params":{"name":"slot_l","expression":"24 mm","comment":"cable pass-through"}},
 {"command":"parameters.add","params":{"name":"slot_w","expression":"8 mm"}},
 {"command":"solid.box","params":{"length":"L","width":"W","height":"T","center":[0,0,"T/2"],"operation":"new","body_name":"baseplate","name":"Plate"}},
 {"command":"solid.fillet","params":{"edges":[[75,40,2.5],[-75,40,2.5],[75,-40,2.5],[-75,-40,2.5]],"radius":"corner_r","body":"baseplate","name":"PlateCorners"}},
 {"command":"solid.cylinder","params":{"diameter":"mount_d","height":"T + 2","base":["L/2 - mount_inset","W/2 - mount_inset",-1],"operation":"cut","targets":["baseplate"],"name":"MountHole"}},
 {"command":"solid.pattern.rectangular","params":{"features":["MountHole"],"dir1":[-1,0,0],"count1":2,"spacing1":"L - 2*mount_inset","dir2":[0,-1,0],"count2":2,"spacing2":"W - 2*mount_inset","name":"MountHoles"}},
 {"command":"solid.box","params":{"length":"slot_w","width":"slot_l","height":"T + 2","center":[0,0,"T/2"],"operation":"cut","targets":["baseplate"],"name":"CableSlot"}},
 {"command":"solid.cylinder","params":{"diameter":"boss_d","height":"boss_h","base":["bx + brd_dx/2","brd_dy/2","T"],"operation":"join","targets":["baseplate"],"name":"BoardBoss"}},
 {"command":"solid.cylinder","params":{"diameter":"spacer_d","height":"boss_h + 0.01 mm","base":["bx + brd_dx/2","brd_dy/2","T"],"operation":"cut","targets":["baseplate"],"name":"SpacerHole"}},
 {"command":"solid.pattern.rectangular","params":{"features":["BoardBoss","SpacerHole"],"dir1":[-1,0,0],"count1":2,"spacing1":"brd_dx","dir2":[0,-1,0],"count2":2,"spacing2":"brd_dy","name":"BoardMounts"}},
 {"command":"solid.box","params":{"length":"dt_len","width":"rail_w","height":"dt_h","center":["gx",0,"T + dt_h/2"],"operation":"join","targets":["baseplate"],"name":"Receiver"}},
 {"command":"sketch.create","params":{"plane":"YZ","offset":"gx - dt_len/2","name":"ChannelSketch"}},
 {"command":"sketch.line","params":{"points":[["-(dt_bot/2 + clr)","T"],["dt_bot/2 + clr","T"],["dt_top/2 + clr","T + dt_h"],["-(dt_top/2 + clr)","T + dt_h"]],"closed":true}},
 {"command":"sketch.finish","params":{}},
 {"command":"solid.extrude","params":{"distance":"dt_len","operation":"cut","targets":["baseplate"],"name":"Channel"}},
 {"command":"solid.box","params":{"length":"stop_t","width":"rail_w","height":"dt_h","center":["gx + dt_len/2 + stop_t/2",0,"T + dt_h/2"],"operation":"join","targets":["baseplate"],"name":"EndStop"}},
 {"command":"solid.cylinder","params":{"diameter":"lock_d","height":"rail_w/2 - dt_top/2 + 1 mm","base":["gx","dt_top/2 - 0.5 mm","T + dt_h/2"],"axis":"Y","operation":"cut","targets":["baseplate"],"name":"LockHole"}},
 {"command":"file.export_step","params":{"path":"gripper_tester/exports/GRIP-0001_X1.step","bodies":["baseplate"]}},
 {"command":"file.export_stl","params":{"path":"gripper_tester/exports/GRIP-0001_X1.stl","bodies":["baseplate"],"quality":"fine"}},
 {"command":"file.export_3mf","params":{"path":"gripper_tester/exports/GRIP-0001_X1.3mf","bodies":["baseplate"],"quality":"fine"}}
]
